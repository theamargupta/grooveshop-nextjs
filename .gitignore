# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# deps / build
node_modules/
.next/
out/
dist/
coverage/

# env / secrets
.env
.env.*
!.env.example

# .claude — ignore the scratch, keep the tooling (agents/commands/hooks/rules/settings.json stay tracked).
# Patterns must be alone on their line: git has NO trailing-comment support, so an inline
# "# ..." became part of the pattern and left .claude/messages/ UNignored (Rule 8 breach).
# Rule 8 drafts, mine alone:
.claude/messages/
.claude/tmp/
.claude/worktrees/
# machine-specific paths + permission grants:
.claude/settings.local.json
.claude/**/.DS_Store

# the cloned source repo is study-only, not part of our app
source-nuxt/

# os / editor
.DS_Store
*.log

# playwright
test-results/
playwright-report/

# Playwright E2E — raw artifacts (regenerable)
docs/reports/e2e-artifacts/
docs/reports/playwright-report/

# Recording build outputs (large/binary — reproducible from narration.md + scripts)
/docs/recording/audio/
/docs/recording/visuals/
